# Copy to .env and edit. NEVER commit .env.
# Format: token:user,token:user   Generate tokens with:  openssl rand -hex 32
TUTOR_API_TOKENS=change-me-long-random-token:alice

# Optional
TUTOR_PORT=8000
TUTOR_TZ=Europe/Kyiv
# Public URL / hostnames when running behind a reverse proxy with TLS
# TUTOR_PUBLIC_URL=https://tutor.example.com
# TUTOR_ALLOWED_HOSTS=tutor.example.com
